#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

board=$(board_name)

case "$board" in
vnpt,gw040h)
	ucidef_set_led_netdev "wan" "WAN" "green:wan" "eth0"
	ucidef_set_led_netdev "lan1" "LAN1" "green:lan1" "lan1"
	ucidef_set_led_netdev "lan2" "LAN2" "green:lan2" "lan2"
	ucidef_set_led_netdev "lan3" "LAN3" "green:lan3" "lan3"
	ucidef_set_led_netdev "lan4" "LAN4" "green:lan4" "lan4"
	ucidef_set_led_netdev "internet" "INTERNET" "green:internet" "wan"
	ucidef_set_led_wlan "wlan2g" "2.4G" "mt76-phy0" "phy0tpt"
	ucidef_set_led_wlan "wlan5g" "5G" "mt76-phy1" "phy1tpt"
	ucidef_set_led_default "power" "POWER" "green:power" "1"
	ucidef_set_led_heartbeat "pon" "PON" "green:pon"
	ucidef_set_led_default "los" "LOS" "red:los" "0"
	;;
esac

board_config_flush

exit 0
